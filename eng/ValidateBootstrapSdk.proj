<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(LatestDotNetCoreForMSBuild)</TargetFramework>
  </PropertyGroup>

  <Target Name="ValidateBootstrapSdk">
    <PropertyGroup>
      <_ExpectedBundledVersions>$([MSBuild]::NormalizePath('$(TestDotNetRoot)', 'sdk', '$(BootstrapSdkVersion)', 'Microsoft.NETCoreSdk.BundledVersions.props'))</_ExpectedBundledVersions>
      <_ActualBundledVersions>$([MSBuild]::NormalizePath('$(NETCoreSdkBundledVersionsProps)'))</_ActualBundledVersions>
      <_ActualRuntime>$([System.Runtime.InteropServices.RuntimeInformation]::FrameworkDescription)</_ActualRuntime>
    </PropertyGroup>
    <Error Condition="'$(NETCoreSdkVersion)' != '$(BootstrapSdkVersion)'"
           Text="The self-build resolved SDK '$(NETCoreSdkVersion)' instead of bootstrap SDK '$(BootstrapSdkVersion)'. Check the stage2 global.json and SDK resolver environment." />
    <Error Condition="'$(_ActualBundledVersions)' != '$(_ExpectedBundledVersions)'"
           Text="The self-build imported SDK defaults from '$(NETCoreSdkBundledVersionsProps)' instead of '$(_ExpectedBundledVersions)'. Remove conflicting SDK resolver overrides." />
    <Error Condition="!Exists('$(TestDotNetRoot)shared/Microsoft.NETCore.App/$(BundledNETCoreAppPackageVersion)')"
           Text="Bootstrap runtime '$(BundledNETCoreAppPackageVersion)' is missing from '$(TestDotNetRoot)'. Rebuild the bootstrap before running tests." />
    <Error Condition="'$(MSBuildRuntimeType)' == 'Core' and '$(_ActualRuntime)' != '.NET $(BundledNETCoreAppPackageVersion)'"
           Text="The self-build runs on '$(_ActualRuntime)' instead of bootstrap runtime '.NET $(BundledNETCoreAppPackageVersion)'. Check the bootstrap host and runtime configuration." />
    <Error Condition="'$(MSBuildRuntimeType)' == 'Full' and '$(SdkResolverMSBuildTaskHostRuntimeVersion)' != '$(BundledNETCoreAppPackageVersion)'"
           Text="The Framework self-build selected task-host runtime '$(SdkResolverMSBuildTaskHostRuntimeVersion)' instead of bootstrap runtime '$(BundledNETCoreAppPackageVersion)'. Check the stage2 SDK resolver environment." />
    <Message Importance="high"
             Text="Self-build engine: $(MSBuildRuntimeType); SDK: $(NETCoreSdkVersion); bootstrap runtime: $(BundledNETCoreAppPackageVersion)." />
  </Target>
</Project>
