<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(FullFrameworkTFM)</TargetFramework>
    <!-- VS Insertion -->
    <TargetVsixContainerName>Microsoft.Build.vsix</TargetVsixContainerName>
    <VisualStudioInsertionComponent>Microsoft.Build</VisualStudioInsertionComponent>

    <ExcludeFromBuild Condition="'$(MSBuildRuntimeType)' != 'Full'">true</ExcludeFromBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Build\Microsoft.Build.csproj" PrivateAssets="All"/>
  </ItemGroup>

  <ItemGroup>
    <SwrProperty Include="ThirdPartyNotice=$(ThirdPartyNotice)" />
    <SwrProperty Include="SourceDir=$(RepoRoot)\src\" />

    <!-- Only add the swr file when building on full framework msbuild, otherwise,
    this triggers a build of the swixproj, which is not supported in core msbuild. -->
    <SwrFile Include="files.swr" Condition=" '$(MSBuildRuntimeType)' == 'Full' " />
  </ItemGroup>

  <!-- GetBinPaths depends on GetBuildVersion which does not get imported if ExcludeFromBuild is true. -->
  <Import Project="..\GetBinPaths.targets" Condition="'$(ExcludeFromBuild)' != 'true'" />

  <Target Name="SetVsixProperties"
    BeforeTargets="Build"
    DependsOnTargets="SetBinPaths"
    Condition="'$(ExcludeFromBuild)' != 'true'">
    <PropertyGroup>
      <_TelemetryExperimentDirectory>$([MSBuild]::NormalizeDirectory('$(IntermediateOutputPath)', 'telemetry-reunification'))</_TelemetryExperimentDirectory>
      <_DefaultVsSetupSwr Condition="'$(VsTelemetryExperimentSource)' == ''">$([MSBuild]::Escape($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)files.swr'))))</_DefaultVsSetupSwr>
    </PropertyGroup>
    <!-- A single timestamped SWR input prevents reusing the other variant's VSIX when opting in or out. -->
    <MakeDir Directories="$(_TelemetryExperimentDirectory)" />
    <WriteLinesToFile Condition="'$(VsTelemetryExperimentSource)' == ''"
                      File="$(_TelemetryExperimentDirectory)files.swr"
                      Lines="$(_DefaultVsSetupSwr)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <Error Condition="'$(VsTelemetryExperimentSource)' != '' and '$(VsTelemetryExperimentExpectedSnapshotHash)' == ''"
           Text="The telemetry experiment requires VsTelemetryExperimentExpectedSnapshotHash. First generate and inspect the intended VS snapshot with Prepare-TelemetryReunification.ps1." />
    <Exec Condition="'$(VsTelemetryExperimentSource)' != ''"
          Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)Prepare-TelemetryReunification.ps1&quot; -VsInstallPath &quot;$(VsTelemetryExperimentSource)&quot; -ExpectedSnapshotHash &quot;$(VsTelemetryExperimentExpectedSnapshotHash)&quot; -OutputDirectory &quot;$(_TelemetryExperimentDirectory).&quot; -X86Config &quot;$(X86BinPath)MSBuild.exe.config&quot; -X64Config &quot;$(X64BinPath)MSBuild.exe.config&quot; -CoordinatorConfig &quot;$(CoordinatorBinPath)MSBuild.Coordinator.exe.config&quot; -CoordinatorX64Config &quot;$(CoordinatorX64BinPath)MSBuild.Coordinator.exe.config&quot;" />
    <ItemGroup>
      <SwrFile Remove="files.swr" />
      <SwrFile Include="$(_TelemetryExperimentDirectory)files.swr" />
      <FileWrites Include="$(_TelemetryExperimentDirectory)files.swr" />
      <SwrProperty Include="Version=$(VsixVersion)" />
      <SwrProperty Include="X86BinPath=$(X86BinPath)" />
      <SwrProperty Include="X64BinPath=$(X64BinPath)" />
      <SwrProperty Include="FrameworkBinPath=$(FrameworkBinPath)" />
      <SwrProperty Include="TaskHostBinPath=$(MSBuildTaskHostBinPath)" />
      <SwrProperty Include="TaskHostX64BinPath=$(MSBuildTaskHostX64BinPath)" />
      <SwrProperty Include="CoordinatorBinPath=$(CoordinatorBinPath)" />
      <SwrProperty Include="CoordinatorX64BinPath=$(CoordinatorX64BinPath)" />
    </ItemGroup>
  </Target>

</Project>
