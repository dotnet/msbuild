<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(TaskTargetFramework)</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.Build.Framework" HintPath="$(MSBuildToolsPath)\Microsoft.Build.Framework.dll" />
    <Reference Include="Microsoft.Build.Utilities.Core" HintPath="$(MSBuildToolsPath)\Microsoft.Build.Utilities.Core.dll" />
  </ItemGroup>
</Project>
