<Project>
  <PropertyGroup>
    <ExampleTaskPath>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', '..', '..', '..', '$(LatestDotNetCoreForMSBuild)', 'ExampleTask.dll'))</ExampleTaskPath>
  </PropertyGroup>

  <UsingTask
    TaskName="ExampleTask"
    AssemblyFile="$(ExampleTaskPath)"
    TaskFactory="TaskHostFactory"
    Runtime="NET" />

  <Target Name="TestParameterBinding">
    <Error Condition="'$(LatestDotNetCoreForMSBuild)' == ''" Text="The LatestDotNetCoreForMSBuild property must be supplied." />
    <ExampleTask
      mode="Deep"
      Modes="Shallow;Deep"
      DestinationFile="single.txt"
      DestinationFiles="first.txt;second.txt">
      <Output TaskParameter="OutputDate" PropertyName="OutputDate" />
      <Output TaskParameter="OutputDates" ItemName="OutputDates" />
    </ExampleTask>
    <Message Text="PARAMETER_OUTPUTS_OK Date=$(OutputDate) Dates=@(OutputDates)" Importance="High" />
  </Target>

  <Target Name="TestModeBinding">
    <Error Condition="'$(LatestDotNetCoreForMSBuild)' == ''" Text="The LatestDotNetCoreForMSBuild property must be supplied." />
    <ExampleTask Mode="$(Mode)" Importance="$(Importance)" />
  </Target>
</Project>
