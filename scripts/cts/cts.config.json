{
  "SourceCodeFiles": {
    "Include": [
      "src/**/*.cs"
    ],
    "Exclude": [
      "**/obj/**",
      "**/bin/**",
      "**/TestAssets/**"
    ]
  },
  "Files": {
    "Exclude": [
      "**/*.md",
      "**/*.yml",
      "**/*.yaml",
      "**/*.png",
      "documentation/**"
    ]
  },
  "Modules": {
    "Include": [],
    "Exclude": [
      "**/Microsoft.Testing.*.dll",
      "**/Microsoft.TestPlatform*.dll",
      "**/Microsoft.VisualStudio.TestPlatform*.dll",
      "**/Microsoft.VisualStudio.CodeCoverage*.dll",
      "**/Microsoft.DotNet.*.dll",
      "**/xunit.*.dll",
      "**/Xunit.*.dll",
      "**/testhost*",
      "**/Microsoft.Bcl.*.dll",
      "**/Microsoft.ApplicationInsights.dll",
      "**/Newtonsoft.Json.dll",
      "**/Shouldly.dll",
      "**/AwesomeAssertions.dll",
      "**/FakeItEasy.dll",
      "**/Verify.*.dll",
      "**/System*.dll",
      "**/runtimes/**"
    ]
  },
  "Filter": {
    "Include": [
      "**/artifacts/bin/StringTools.UnitTests/Debug/net11.0/Microsoft.NET.StringTools.UnitTests.dll",
      "**/artifacts/bin/Microsoft.Build.Framework.UnitTests/Debug/net11.0/Microsoft.Build.Framework.UnitTests.dll",
      "**/artifacts/bin/Microsoft.Build.Utilities.UnitTests/Debug/net11.0/Microsoft.Build.Utilities.UnitTests.dll",
      "**/artifacts/bin/Microsoft.Build.Engine.OM.UnitTests/Debug/net11.0/Microsoft.Build.Engine.OM.UnitTests.dll",
      "**/artifacts/bin/Microsoft.Build.CommandLine.UnitTests/Debug/net11.0/Microsoft.Build.CommandLine.UnitTests.dll",
      "**/artifacts/bin/Microsoft.Build.Engine.UnitTests/Debug/net11.0/Microsoft.Build.Engine.UnitTests.dll",
      "**/artifacts/bin/Microsoft.Build.Tasks.UnitTests/Debug/net11.0/Microsoft.Build.Tasks.UnitTests.dll",
      "**/artifacts/bin/Microsoft.Build.BuildCheck.UnitTests/Debug/net11.0/Microsoft.Build.BuildCheck.UnitTests.dll"
    ],
    "Exclude": [
      "**/*.resources.dll"
    ]
  }
}